#
# postinst — runs after opentelemetry-injector is installed or upgraded.

set -e

case "$1" in
    configure|abort-upgrade|abort-deconfigure|abort-remove)
        /usr/share/opentelemetry-injector/postinstall-injector.sh
        ;;
esac

#DEBHELPER#
