#
# prerm — runs before opentelemetry-injector is removed or upgraded away.

set -e

case "$1" in
    remove|upgrade|deconfigure)
        /usr/share/opentelemetry-injector/preuninstall-injector.sh
        ;;
esac

#DEBHELPER#
