#
# Lifecycle test image (DEB). Installs ONLY opentelemetry-injector from the
# LOCAL apt repository produced by build-local-repo.sh, then runs the lifecycle
# assertions in test.sh. Mirrors upstream packaging/tests/lifecycle with the
# injector deb always coming from this repo's build.

ARG BASE_IMAGE=debian:12
FROM ${BASE_IMAGE}

RUN apt-get update && apt-get install -y \
    apt-utils \
    dpkg-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Local APT repository built from this repo's .deb files (see build-local-repo.sh).
COPY build/local-repo/apt /local-repo
RUN echo 'deb [trusted=yes] file:///local-repo stable main' \
    > /etc/apt/sources.list.d/opentelemetry-local.list

# Install the injector from the local repo, and VERIFY it really resolved from
# pool/ (i.e. the local deb) rather than from a remote source.
RUN apt-get update && apt-get install -y --no-install-recommends opentelemetry-injector
RUN if apt-cache show opentelemetry-injector | sed -n 's/^Filename: //p' | grep -q '^pool/'; then \
      echo "injector deb source: local repo (good)"; \
    else \
      echo "ERROR: opentelemetry-injector did not resolve from the local repo"; \
      exit 1; \
    fi

COPY packaging/tests/lifecycle/test.sh /test-lifecycle.sh
CMD ["sh", "/test-lifecycle.sh"]